# UPR-MVS Local Training Configuration (RTX 5060Ti 16GB)
# 用于本地开发调试 - 防 OOM 版本（包含三阶段优化）

# ==================== Model Architecture ====================
model:
  backbone: dinov3
  dinov3_name: dinov3_vitb16
  dinov3_pretrained: /home/william/project/dataset/DINOv3/pre_trained/dinov3_vitb16_pretrain_lvd1689m-73cec8be.pth
  dinov3_output_layers: [3, 7, 11]
  attention_backend: sdpa
  sva_layers: [3, 6, 9]
  sva_dropout: 0.0
  use_checkpoint: true                          # ✅ 必须启用，防止 OOM

  # Stage 1: CCFF Feature Fusion (特征融合模块)
  ccff:
    enable: true                # ✅ 本地也启用，保持架构一致
    in_channels: [256, 256, 256]  # backbone 投影后的三层输出
    hidden_dim: 128             # ⬇️ 从 256 降到 128，减少显存
    out_index: 1                # 使用中间尺度输出，避免最高分辨率 cost volume OOM
    depth_mult: 1.0
    expansion: 1.0
    act: silu
  
  # Stage 2: Depth Refinement Head (深度细化模块)
  depth_refinement:
    enable: true                # ✅ 本地也启用
    in_channels: 1
    hidden_channels: 8          # ⬇️ 从 16 降到 8
    out_channels: 1

  cvt:
    feat_key: ccff_output       # ✅ 使用 CCFF 融合后的特征
    feature_dim: 256
    num_layers: 4               # ⬇️ 从 6 降到 4
    nhead: 8
    fpe_enable: true
    aas_enable: true
    d_bins: 64                  # ⬇️ 本地保持 64（scale=4 时 16 bins）
    scales: [4, 8, 16]
    num_groups: 4               # ⬇️ 从 8 降到 4
    attention_backend: sdpa
    use_checkpoint: true        # ✅ 必须启用
    share_across_scales: false

  point:
    num_points: 8000                            # ⬇️ 从 12000 降到 8000
    use_all_if_fewer: true
    use_gt_mask_for_sampling: true
    feat_dim: 160
    lift_stage_keys: [stage1, stage2, stage3]
    knn: 16
    candidate_k: 32                             # ⬇️ 从 64 降到 32
    edgeconv_layers: [128, 192, 256]
    delta_scale: 0.01
    use_checkpoint: true                        # ✅ 必须启用
    predict_uncertainty: true

  densify:
    enable: false

# ==================== Dataset ====================
data:
  dataset: dtu
  train_root: /home/william/project/dataset/DTU/dtu_training
  val_root: /home/william/project/dataset/DTU/dtu_training
  test_root: /home/william/project/dataset/DTU/dtu_test
  test_gt_root: /home/william/project/dataset/DTU/dtu_training
  train_layout: trainval
  val_layout: trainval
  test_layout: dtu_test
  train_list: lists/dtu/train.txt
  val_list: lists/dtu/val.txt
  test_list: lists/dtu/test.txt
  pair_file: Cameras/pair.txt
  camera_dir: Cameras
  rectified_dir: Rectified_raw
  depth_dir: Depths_raw
  mask_dir: Depths_raw
  test_image_dir: images
  test_camera_dirs: [cams_1, cams]
  test_pair_file: pair.txt
  img_h: 512                                    # ⬇️ 从 1024 降到 512
  img_w: 640                                    # ⬇️ 从 1280 降到 640
  n_views: 3                                    # ⬇️ 从 5 降到 3，减少显存
  train_light_ids: [0, 1, 2]
  eval_light_ids: [3]
  depth_scale: 1.0

# ==================== Training Stages ====================
# 本地三阶段快速测试配置 - 防 OOM 版本
training_stages:
  # Stage A: Coarse Depth Pretraining
  stage_a:
    name: coarse_only
    epochs: 5                                   # ⬇️ 从 20 降到 5，快速验证
    batch_size_per_gpu: 2                       # ✅ 5060Ti 16GB: 保守设置
    grad_accum_steps: 8                         # 等效 batch = 16
    lr_backbone: 0.00005
    lr_coarse: 0.0001
    warmup_epochs: 2
    loss_weights:
      coarse_weight: 1.0
      chamfer_weight: 0.0
      uncertainty_weight: 0.0
      feature_weight: 0.0
  
  # Stage B: Point Refiner Training
  stage_b:
    name: point_refine
    epochs: 5
    batch_size_per_gpu: 2                       # ✅ 5060Ti 16GB
    grad_accum_steps: 6                         # 等效 batch = 12
    lr_backbone: 0.0
    lr_coarse: 0.0
    lr_point: 0.0002
    warmup_epochs: 1
    model:
      point:
        use_checkpoint: true
      densify:
        enable: true
    loss_weights:
      coarse_weight: 0.0
      chamfer_weight: 1.0
      uncertainty_weight: 0.2
      feature_weight: 0.5
  
  # Stage C: Joint Fine-tuning
  stage_c:
    name: joint
    epochs: 5
    batch_size_per_gpu: 1                       # ✅ 5060Ti 16GB (joint 阶段显存占用最大)
    grad_accum_steps: 8                         # 等效 batch = 8
    lr_backbone: 0.000025
    lr_coarse: 0.00001
    lr_point: 0.0002
    warmup_epochs: 1
    model:
      point:
        use_checkpoint: true
      densify:
        enable: true
    loss_weights:
      coarse_weight: 0.1
      chamfer_weight: 1.0
      uncertainty_weight: 0.2
      feature_weight: 0.5

# ==================== Default Training Config ====================
# 默认使用 Stage A 配置（第一阶段）
train:
  stage: coarse_only
  epochs: 5                                     # ⬇️ 本地快速测试
  batch_size_per_gpu: 2                         # ✅ 5060Ti 16GB
  batch_size_point_per_gpu: 2
  batch_size_joint_per_gpu: 1
  num_workers: 4                                # ⬇️ 减少 CPU 内存占用
  grad_accum_steps: 8
  grad_clip: 1.0
  amp_dtype: fp16                               # ✅ 本地优先使用 fp16（更快）
  use_ddp: false
  seed: 42
  log_interval: 10                              # ⬇️ 更频繁输出日志
  val_interval: 1
  save_interval: 2
  monitor_key: depth_abs_error
  use_loss_nan_check: true
  early_stop_on_nan: true
  tensorboard:
    enable: true
    log_dir: tensorboard
    scalar_interval: 10
    image_interval: 100
    feature_stage: stage2

# ==================== Optimizer ====================
optim:
  name: adamw
  lr_backbone: 0.00005
  lr_coarse: 0.0001
  lr_point: 0.0002
  joint_coarse_lr_scale: 0.2
  weight_decay: 0.01
  betas: [0.9, 0.999]
  warmup_epochs: 2
  warmup_lr_init: 1.0e-6

scheduler:
  name: cosine
  min_lr: 1.0e-6

# ==================== Loss Weights ====================
loss:
  coarse_weight: 1.0
  chamfer_weight: 0.0
  uncertainty_weight: 0.0
  feature_weight: 0.0

# ==================== DDP Settings ====================
ddp:
  backend: nccl
  find_unused_parameters: false
  broadcast_buffers: false

# UPR-MVS Local Training Configuration (Development/Debug)
# 用于本地开发调试的单卡训练配置

# ==================== Model Architecture ====================
model:
  backbone: dinov3
  dinov3_name: dinov3_vitb14                    # 使用更小的模型进行调试
  dinov3_pretrained: null                        # 本地调试可不加载预训练
  dinov3_output_layers: [3, 7, 11]
  attention_backend: sdpa
  sva_layers: [3, 6, 9]
  sva_dropout: 0.0
  use_checkpoint: true

  cvt:
    feat_key: stage2
    feature_dim: 128                             # 减小特征维度
    num_layers: 4                                # 减少层数
    nhead: 4
    fpe_enable: true
    aas_enable: true
    d_bins: 32                                   # 减少深度 bin 数量
    scales: [4, 8, 16]
    num_groups: 4
    attention_backend: sdpa
    use_checkpoint: true
    share_across_scales: false

  point:
    num_points: 8000                             # 减少点数量
    use_all_if_fewer: true
    use_gt_mask_for_sampling: true
    feat_dim: 128
    lift_stage_keys: [stage1, stage2, stage3]
    knn: 8
    candidate_k: 32
    edgeconv_layers: [64, 128, 192]
    delta_scale: 0.01
    use_checkpoint: false
    predict_uncertainty: true

  densify:
    enable: false

# ==================== Dataset ====================
data:
  dataset: dtu
  train_root: ./data/DTU/dtu_training            # 本地相对路径
  val_root: ./data/DTU/dtu_training
  test_root: ./data/DTU/dtu_test
  test_gt_root: ./data/DTU/dtu_training
  train_layout: trainval
  val_layout: trainval
  test_layout: dtu_test
  train_list: lists/dtu/train.txt
  val_list: lists/dtu/val.txt
  test_list: lists/dtu/test.txt
  pair_file: Cameras/pair.txt
  camera_dir: Cameras
  rectified_dir: Rectified_raw
  depth_dir: Depths_raw
  mask_dir: Depths_raw
  test_image_dir: images
  test_camera_dirs: [cams_1, cams]
  test_pair_file: pair.txt
  img_h: 512                                     # 降低分辨率
  img_w: 640
  n_views: 3                                     # 减少视图数量
  train_light_ids: [0, 1, 2]
  eval_light_ids: [3]
  depth_scale: 1.0

# ==================== Training Stages ====================
training_stages:
  stage_a:
    name: coarse_only
    epochs: 5                                    # 本地调试减少 epoch
    batch_size_per_gpu: 2
    grad_accum_steps: 4
    lr_backbone: 0.0001
    lr_coarse: 0.0002
    warmup_epochs: 1
    loss_weights:
      coarse_weight: 1.0
      chamfer_weight: 0.0
      uncertainty_weight: 0.0
      feature_weight: 0.0
  
  stage_b:
    name: point_refine
    epochs: 5
    batch_size_per_gpu: 2
    grad_accum_steps: 4
    lr_backbone: 0.0
    lr_coarse: 0.0
    lr_point: 0.0004
    warmup_epochs: 1
    model:
      point:
        use_checkpoint: false
      densify:
        enable: true
    loss_weights:
      coarse_weight: 0.0
      chamfer_weight: 1.0
      uncertainty_weight: 0.2
      feature_weight: 0.5
  
  stage_c:
    name: joint
    epochs: 5
    batch_size_per_gpu: 1
    grad_accum_steps: 4
    lr_backbone: 0.00005
    lr_coarse: 0.00002
    lr_point: 0.0004
    warmup_epochs: 1
    model:
      point:
        use_checkpoint: true
      densify:
        enable: true
    loss_weights:
      coarse_weight: 0.1
      chamfer_weight: 1.0
      uncertainty_weight: 0.2
      feature_weight: 0.5

# ==================== Default Training Config ====================
train:
  stage: coarse_only
  epochs: 5
  batch_size_per_gpu: 2
  batch_size_point_per_gpu: 2
  batch_size_joint_per_gpu: 2
  num_workers: 4                                 # 减少 worker 数量
  grad_accum_steps: 4
  grad_clip: 1.0
  amp_dtype: bf16
  use_ddp: false
  seed: 42
  log_interval: 10                               # 更频繁的日志
  val_interval: 1
  save_interval: 1
  monitor_key: depth_abs_error
  use_loss_nan_check: true
  early_stop_on_nan: true
  tensorboard:
    enable: true
    log_dir: tensorboard
    scalar_interval: 10
    image_interval: 100
    feature_stage: stage2

# ==================== Optimizer ====================
optim:
  name: adamw
  lr_backbone: 0.0001
  lr_coarse: 0.0002
  lr_point: 0.0004
  joint_coarse_lr_scale: 0.2
  weight_decay: 0.01
  betas: [0.9, 0.999]
  warmup_epochs: 1
  warmup_lr_init: 1.0e-6

scheduler:
  name: cosine
  min_lr: 1.0e-6

# ==================== Loss Weights ====================
loss:
  coarse_weight: 1.0
  chamfer_weight: 0.0
  uncertainty_weight: 0.0
  feature_weight: 0.0
  repulsion_weight: 0.0
  alpha_weight: 0.0
  alpha_error_threshold: 2.0
  feature_stage: stage2
  depth_loss_scale: 0.01
  chamfer_loss_scale: 0.001

# ==================== DDP Settings ====================
ddp:
  backend: nccl
  find_unused_parameters: false
  broadcast_buffers: false

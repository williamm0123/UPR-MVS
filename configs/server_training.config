# UPR-MVS Server Training Configuration (A100 80GB Single GPU)
# 用于服务器 A100 80GB 单卡三阶段自动训练 - 批量提升版本

# ==================== Model Architecture ====================
model:
  backbone: dinov3
  dinov3_name: dinov3_vitb16
  dinov3_pretrained: /scr/user/qinglong/dataset/DINOv3/pre_trained/dinov3_vitb16_pretrain_lvd1689m-73cec8be.pth
  dinov3_output_layers: [3, 7, 11]  # stage1, stage2, stage3
  attention_backend: sdpa
  sva_layers: [3, 6, 9]
  sva_dropout: 0.0
  use_checkpoint: true          # ✅ 必须启用，节省 60-70% 显存

  # Stage 1: CCFF Feature Fusion (特征融合模块)
  ccff:
    enable: true                # ✅ 启用 CCFF 融合三层特征
    in_channels: [256, 256, 256]  # backbone 投影后的三层输出
    hidden_dim: 128             # 保持保守复杂度，优先通过 batch 利用显存
    out_index: 1                # 使用中间尺度输出，避免最高分辨率 cost volume OOM
    depth_mult: 1.0
    expansion: 1.0
    act: silu
  
  # Stage 2: Depth Refinement Head (深度细化模块)
  depth_refinement:
    enable: true                # ✅ 启用 2D refinement head
    in_channels: 1              # 输入只有 coarse depth
    hidden_channels: 16
    out_channels: 1

  cvt:
    feat_key: ccff_output       # ✅ 使用 CCFF 融合后的特征（而非仅 stage2）
    feature_dim: 128            # 保持保守复杂度
    num_layers: 4               # 保持保守复杂度
    nhead: 8
    fpe_enable: true
    aas_enable: true
    d_bins: 128                 # 先不提高单样本计算量
    scales: [4, 8, 16]
    num_groups: 4               # ⬇️ 从 8 降到 4，减少 group-wise correlation 显存
    attention_backend: sdpa
    use_checkpoint: true        # ✅ 必须启用
    share_across_scales: false

  point:
    num_points: 8000            # 保持保守复杂度
    use_all_if_fewer: true
    use_gt_mask_for_sampling: true
    feat_dim: 160
    lift_stage_keys: [stage1, stage2, stage3]
    knn: 16
    candidate_k: 64
    edgeconv_layers: [128, 192, 256]
    delta_scale: 0.01
    use_checkpoint: true        # ✅ Stage B/C 都启用
    predict_uncertainty: true

  densify:
    enable: false               # Stage A 禁用

# ==================== Dataset ====================
data:
  dataset: dtu
  train_root: /scr/user/qinglong/dataset/DTU/dtu_training
  val_root: /scr/user/qinglong/dataset/DTU/dtu_training
  test_root: /scr/user/qinglong/dataset/DTU/dtu_test
  test_gt_root: /scr/user/qinglong/dataset/DTU/dtu_training
  train_layout: trainval
  val_layout: trainval
  test_layout: dtu_test
  train_list: lists/dtu/train.txt
  val_list: lists/dtu/val.txt
  test_list: lists/dtu/test.txt
  pair_file: Cameras/pair.txt
  camera_dir: Cameras
  rectified_dir: Rectified_raw
  depth_dir: Depths_raw
  mask_dir: Depths_raw
  test_image_dir: images
  test_camera_dirs: [cams_1, cams]
  test_pair_file: pair.txt
  img_h: 768
  img_w: 1024
  n_views: 5
  train_light_ids: [0, 1, 2, 3, 4, 5, 6]
  eval_light_ids: [3]
  depth_scale: 1.0

# ==================== Training Stages ====================
# 服务器 A100 80GB 三阶段训练配置 - 批量提升版本
training_stages:
  # Stage A: Coarse Depth Pretraining
  stage_a:
    name: coarse_only
    epochs: 20
    batch_size_per_gpu: 8                       # ⬆️ 优先增加 batch，提升显存利用率
    grad_accum_steps: 4                         # 等效 batch = 32
    lr_backbone: 0.00005
    lr_coarse: 0.0001
    warmup_epochs: 3
    loss_weights:
      coarse_weight: 1.0
      chamfer_weight: 0.0
      uncertainty_weight: 0.0
      feature_weight: 0.0
  
  # Stage B: Point Refiner Training
  stage_b:
    name: point_refine
    epochs: 20
    batch_size_per_gpu: 4                       # ⬆️ 优先增加 batch
    grad_accum_steps: 6                         # 等效 batch = 24
    lr_backbone: 0.0
    lr_coarse: 0.0
    lr_point: 0.0002
    warmup_epochs: 1
    model:
      point:
        use_checkpoint: true
      densify:
        enable: true
    loss_weights:
      coarse_weight: 0.0
      chamfer_weight: 1.0
      uncertainty_weight: 0.2
      feature_weight: 0.5
  
  # Stage C: Joint Fine-tuning
  stage_c:
    name: joint
    epochs: 20
    batch_size_per_gpu: 2                       # joint 阶段仍保持谨慎
    grad_accum_steps: 8                         # 等效 batch = 16
    lr_backbone: 0.000025
    lr_coarse: 0.00001
    lr_point: 0.0002
    warmup_epochs: 2
    model:
      point:
        use_checkpoint: true
      densify:
        enable: true
    loss_weights:
      coarse_weight: 0.1
      chamfer_weight: 1.0
      uncertainty_weight: 0.2
      feature_weight: 0.5

# ==================== Default Training Config ====================
# 默认使用 Stage A 配置（第一阶段）
train:
  stage: coarse_only
  epochs: 20
  batch_size_per_gpu: 8
  batch_size_point_per_gpu: 4
  batch_size_joint_per_gpu: 2
  num_workers: 6                              # GPU 已吃满，适度即可
  grad_accum_steps: 4
  grad_clip: 1.0
  amp_dtype: bf16                             # ✅ A100 优先使用 bfloat16
  use_ddp: false
  seed: 42
  log_interval: 20
  val_interval: 1
  save_interval: 2
  monitor_key: depth_abs_error
  use_loss_nan_check: true
  early_stop_on_nan: true
  tensorboard:
    enable: true
    log_dir: tensorboard
    scalar_interval: 20
    image_interval: 500
    feature_stage: stage2

# ==================== Optimizer ====================
optim:
  name: adamw
  lr_backbone: 0.00005
  lr_coarse: 0.0001
  lr_point: 0.0002
  joint_coarse_lr_scale: 0.2
  weight_decay: 0.01
  betas: [0.9, 0.999]
  warmup_epochs: 3
  warmup_lr_init: 1.0e-6

scheduler:
  name: cosine
  min_lr: 1.0e-6

# ==================== Loss Weights ====================
loss:
  coarse_weight: 1.0
  chamfer_weight: 0.0
  uncertainty_weight: 0.0
  feature_weight: 0.0
  repulsion_weight: 0.0
  alpha_weight: 0.0
  alpha_error_threshold: 2.0
  feature_stage: stage2
  depth_loss_scale: 0.01
  chamfer_loss_scale: 0.001

# ==================== DDP Settings ====================
ddp:
  backend: nccl
  find_unused_parameters: false
  broadcast_buffers: false

# UPR-MVS Server Training Configuration (A100 80GB Single GPU)
# 用于服务器单卡三阶段自动训练

# ==================== Model Architecture ====================
model:
  backbone: dinov3
  dinov3_name: dinov3_vitb16
  dinov3_pretrained: /scr/user/qinglong/dataset/DINOv3/pre_trained/dinov3_vitb16_pretrain_lvd1689m-73cec8be.pth
  dinov3_output_layers: [3, 7, 11]
  attention_backend: sdpa
  sva_layers: [3, 6, 9]
  sva_dropout: 0.0
  use_checkpoint: true          # ✅ 必须启用，节省显存

  cvt:
    feat_key: stage2
    feature_dim: 256
    num_layers: 6
    nhead: 8
    fpe_enable: true
    aas_enable: true
    d_bins: 64
    scales: [4, 8, 16]
    num_groups: 8
    attention_backend: sdpa
    use_checkpoint: true        # ✅ 必须启用
    share_across_scales: false

  point:
    num_points: 12000
    use_all_if_fewer: true
    use_gt_mask_for_sampling: true
    feat_dim: 160
    lift_stage_keys: [stage1, stage2, stage3]
    knn: 16
    candidate_k: 64
    edgeconv_layers: [128, 192, 256]
    delta_scale: 0.01
    use_checkpoint: false       # Stage A 不训练 point
    predict_uncertainty: true

  densify:
    enable: false               # Stage A 禁用

# ==================== Dataset ====================
data:
  dataset: dtu
  train_root: /scr/user/qinglong/dataset/DTU/dtu_training
  val_root: /scr/user/qinglong/dataset/DTU/dtu_training
  test_root: /scr/user/qinglong/dataset/DTU/dtu_test
  test_gt_root: /scr/user/qinglong/dataset/DTU/dtu_training
  train_layout: trainval
  val_layout: trainval
  test_layout: dtu_test
  train_list: lists/dtu/train.txt
  val_list: lists/dtu/val.txt
  test_list: lists/dtu/test.txt
  pair_file: Cameras/pair.txt
  camera_dir: Cameras
  rectified_dir: Rectified_raw
  depth_dir: Depths_raw
  mask_dir: Depths_raw
  test_image_dir: images
  test_camera_dirs: [cams_1, cams]
  test_pair_file: pair.txt
  img_h: 1024
  img_w: 1280
  n_views: 5
  train_light_ids: [0, 1, 2, 3, 4, 5, 6]
  eval_light_ids: [3]
  depth_scale: 1.0

# ==================== Training Stages ====================
# 自动三阶段训练配置
training_stages:
  # Stage A: Coarse Depth Pretraining
  stage_a:
    name: coarse_only
    epochs: 20
    batch_size_per_gpu: 4
    grad_accum_steps: 8
    lr_backbone: 0.00005
    lr_coarse: 0.0001
    warmup_epochs: 3
    loss_weights:
      coarse_weight: 1.0
      chamfer_weight: 0.0
      uncertainty_weight: 0.0
      feature_weight: 0.0
  
  # Stage B: Point Refiner Training
  stage_b:
    name: point_refine
    epochs: 20
    batch_size_per_gpu: 4
    grad_accum_steps: 6
    lr_backbone: 0.0
    lr_coarse: 0.0
    lr_point: 0.0002
    warmup_epochs: 1
    model:
      point:
        use_checkpoint: false
      densify:
        enable: true
    loss_weights:
      coarse_weight: 0.0
      chamfer_weight: 1.0
      uncertainty_weight: 0.2
      feature_weight: 0.5
  
  # Stage C: Joint Fine-tuning
  stage_c:
    name: joint
    epochs: 20
    batch_size_per_gpu: 2
    grad_accum_steps: 8
    lr_backbone: 0.000025
    lr_coarse: 0.00001
    lr_point: 0.0002
    warmup_epochs: 2
    model:
      point:
        use_checkpoint: true
      densify:
        enable: true
    loss_weights:
      coarse_weight: 0.1
      chamfer_weight: 1.0
      uncertainty_weight: 0.2
      feature_weight: 0.5

# ==================== Default Training Config ====================
# 默认使用 Stage A 配置（第一阶段）
train:
  stage: coarse_only
  epochs: 20
  batch_size_per_gpu: 4
  batch_size_point_per_gpu: 4
  batch_size_joint_per_gpu: 4
  num_workers: 8
  grad_accum_steps: 8
  grad_clip: 1.0
  amp_dtype: bf16
  use_ddp: false
  seed: 42
  log_interval: 20
  val_interval: 1
  save_interval: 2
  monitor_key: depth_abs_error
  use_loss_nan_check: true
  early_stop_on_nan: true
  tensorboard:
    enable: true
    log_dir: tensorboard
    scalar_interval: 20
    image_interval: 500
    feature_stage: stage2

# ==================== Optimizer ====================
optim:
  name: adamw
  lr_backbone: 0.00005
  lr_coarse: 0.0001
  lr_point: 0.0002
  joint_coarse_lr_scale: 0.2
  weight_decay: 0.01
  betas: [0.9, 0.999]
  warmup_epochs: 3
  warmup_lr_init: 1.0e-6

scheduler:
  name: cosine
  min_lr: 1.0e-6

# ==================== Loss Weights ====================
loss:
  coarse_weight: 1.0
  chamfer_weight: 0.0
  uncertainty_weight: 0.0
  feature_weight: 0.0
  repulsion_weight: 0.0
  alpha_weight: 0.0
  alpha_error_threshold: 2.0
  feature_stage: stage2
  depth_loss_scale: 0.01
  chamfer_loss_scale: 0.001

# ==================== DDP Settings ====================
ddp:
  backend: nccl
  find_unused_parameters: false
  broadcast_buffers: false

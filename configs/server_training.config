# UPR-MVS + Depth Anything 3 metric prior
# 服务器单卡 / 多卡统一配置：
# 1. 不再训练 coarse depth
# 2. 使用 DA3 metric depth 作为冻结 depth prior
# 3. 训练重点放在 point refinement / uncertainty / adaptive densify

model:
  backbone: depth_anything3
  use_gt_mask_for_sampling: true

  depth_anything3:
    variant: vitl
    pretrained: depth-anything/da3metric-large
    trainable: false
    out_layers: [4, 11, 17, 23]
    feature_dim: 256
    feature_layer_indices: [0, 1, 3]
    metric_scale_factor: 300.0
    depth_conf_beta: 2.0
    image_texture_weight: 0.35
    use_sky_head: true

  point:
    num_points: 12000
    use_all_if_fewer: true
    feat_dim: 160
    lift_stage_keys: [stage1, stage2, stage3]
    knn: 16
    candidate_k: 64
    edgeconv_layers: [128, 192, 256]
    delta_scale: 0.05
    use_checkpoint: true
    predict_uncertainty: true
    sampling_strategy: score_hybrid
    sampling_topk_ratio: 0.75
    sampling_coverage_grid_size: 6

  densify:
    enable: false

data:
  dataset: dtu
  train_root: /scr/user/qinglong/dataset/DTU/dtu_training
  val_root: /scr/user/qinglong/dataset/DTU/dtu_training
  test_root: /scr/user/qinglong/dataset/DTU/dtu_test
  test_gt_root: /scr/user/qinglong/dataset/DTU/dtu_training
  train_layout: trainval
  val_layout: trainval
  test_layout: dtu_test
  train_list: lists/dtu/train.txt
  val_list: lists/dtu/val.txt
  test_list: lists/dtu/test.txt
  pair_file: Cameras/pair.txt
  camera_dir: Cameras
  rectified_dir: Rectified_raw
  depth_dir: Depths_raw
  mask_dir: Depths_raw
  test_image_dir: images
  test_camera_dirs: [cams_1, cams]
  test_pair_file: pair.txt
  img_h: 756
  img_w: 1008
  n_views: 5
  train_light_ids: [0, 1, 2, 3, 4, 5, 6]
  eval_light_ids: [3]
  depth_scale: 1.0

training_stages:
  stage_a:
    name: point_refine
    epochs: 12
    batch_size_per_gpu: 4
    grad_accum_steps: 2
    lr_prior: 0.0
    lr_point: 0.0003
    warmup_epochs: 1
    model:
      densify:
        enable: false
    loss_weights:
      coarse_weight: 0.0
      chamfer_weight: 1.0
      uncertainty_weight: 0.2
      feature_weight: 0.5
      repulsion_weight: 0.0
      alpha_weight: 0.0

  stage_b:
    name: joint
    epochs: 12
    batch_size_per_gpu: 2
    grad_accum_steps: 2
    lr_prior: 0.0
    lr_point: 0.0002
    warmup_epochs: 1
    model:
      densify:
        enable: true
    loss_weights:
      coarse_weight: 0.0
      chamfer_weight: 1.0
      uncertainty_weight: 0.2
      feature_weight: 0.5
      repulsion_weight: 0.05
      alpha_weight: 0.2

train:
  run_mode: curriculum
  stage: point_refine
  epochs: 12
  batch_size_per_gpu: 4
  batch_size_point_per_gpu: 4
  batch_size_joint_per_gpu: 2
  num_workers: 4
  grad_accum_steps: 2
  grad_clip: 1.0
  amp_dtype: bf16
  use_ddp: true
  seed: 42
  log_interval: 20
  val_interval: 1
  save_interval: 1
  monitor_key: auto
  use_loss_nan_check: true
  early_stop_on_nan: true
  tensorboard:
    enable: true
    log_dir: .
    scalar_interval: 50
    image_interval: 50
    feature_stage: stage2

optim:
  name: adamw
  lr_prior: 0.0
  lr_point: 0.0003
  joint_prior_lr_scale: 1.0
  weight_decay: 0.01
  betas: [0.9, 0.999]
  warmup_epochs: 1
  warmup_lr_init: 1.0e-6

scheduler:
  name: cosine
  min_lr: 1.0e-6

loss:
  coarse_weight: 0.0
  chamfer_weight: 1.0
  uncertainty_weight: 0.2
  feature_weight: 0.5
  repulsion_weight: 0.0
  alpha_weight: 0.0
  alpha_error_threshold: 2.0
  feature_stage: stage2
  depth_loss_scale: 1.0
  chamfer_loss_scale: 0.001

ddp:
  backend: nccl
  find_unused_parameters: false
  broadcast_buffers: false
